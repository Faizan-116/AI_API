# Copy this file to .env and fill in real values.

ENVIRONMENT=development
FRONTEND_ORIGIN=http://localhost:5173

# SQLite by default; swap for a real Postgres URL in production, e.g.
# postgresql+psycopg2://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./portfolio.db

# Working hours (24h) used to compute booking availability
BOOKING_DAY_START_HOUR=9
BOOKING_DAY_END_HOUR=18
BOOKING_SLOT_MINUTES=30
BOOKING_LOOKAHEAD_DAYS=14

# Google Calendar (see scripts/generate_google_token.py)
GOOGLE_CALENDAR_CREDENTIALS_FILE=credentials.json
GOOGLE_CALENDAR_TOKEN_FILE=token.json
GOOGLE_CALENDAR_ID=primary

# Turnitin Core API (TCA) - requires a Turnitin integration agreement
TURNITIN_BASE_URL=
TURNITIN_API_KEY=
TURNITIN_INTEGRATION_NAME=portfolio-site
TURNITIN_INTEGRATION_VERSION=1.0.0
